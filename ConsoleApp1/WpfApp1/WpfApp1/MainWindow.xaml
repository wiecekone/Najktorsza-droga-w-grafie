<Window x:Class="ShireTransportFrontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShireTransportFrontend"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Shire Transport"
        Height="950" Width="1450"
        Background="#363636">

    <Grid Margin="10" Background="#262626">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312*"/>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="431*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Foreground="White"
                  Header="Dane wejściowe"
                  BorderThickness="0.1"
                  Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                  Margin="5,5,5,31">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">
                    <TextBlock FontSize="14" Margin="3,5,0,5" Foreground="White"
                               Text="Regiony (ciąg wierzchołków i ilość jęczmienia):"
                               FontWeight="DemiBold"/>
                    <TextBox Background="#363636" Foreground="#d4d4d4"
                             x:Name="RegionyTextBox"
                             Height="100"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="# Przykład formatu: x1,y1;x2,y2;...;xn,yn:ilośćJęczmieniaNaPole"/>

                    <Separator Margin="5"/>
                    <TextBlock FontSize="14" Margin="3,5,0,5" Foreground="White"
                               Text="Pola (x,y) – oddzielaj średnikiem:"
                               FontWeight="DemiBold"/>
                    <TextBox Background="#363636" Foreground="#d4d4d4"
                             x:Name="PolaTextBox"
                             Height="60"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="# Przykład: 2,2;3,7;12,3"/>

                    <Separator Margin="5"/>
                    <TextBlock FontSize="14" Margin="3,5,0,5" Foreground="White"
                               Text="Browary (x,y:pojemnoscJeczmienia)"
                               FontWeight="DemiBold"/>
                    <TextBox Background="#363636" Foreground="#d4d4d4"
                             x:Name="BrowaryTextBox"
                             Height="60"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="# Przykład: 5,5:8;15,5:10"/>

                    <Separator Margin="5"/>
                    <TextBlock FontSize="14" Margin="3,5,0,5" Foreground="White"
                               Text="Karczmy (x,y)"
                               FontWeight="DemiBold"/>
                    <TextBox Background="#363636" Foreground="#d4d4d4"
                             x:Name="KarczmyTextBox"
                             Height="60"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="# Przykład: 4,9;18,6"/>

                    <Separator Margin="5"/>
                    <TextBlock FontSize="14" Margin="3,5,0,5" Foreground="White"
                               Text="Drogi (x1,y1-x2,y2:pojemnoscJeczmienia,pojemnoscPiwa,kosztNaprawy)"
                               FontWeight="DemiBold"/>
                    <TextBox Background="#363636" Foreground="#d4d4d4"
                             x:Name="DrogiTextBox"
                             Height="100"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="# Przykład:\n# 2,2-5,5:4,3,10; 3,7-5,5:2,2,5; 12,3-15,5:6,5,12"/>

                    <Button Content="Zapisz do pliku" FontWeight="DemiBold"  Click="ZapiszPlik_Click" Margin="0,15,0,10" Width="250" Height="25" Background="#3c9152" Foreground="White" Style="{StaticResource ZielonyButton}"/>
                    <Button Content="Wczytaj z pliku" FontWeight="DemiBold" Click="WczytajPlik_Click" Width="250" Height="25" Background="#3c9152" Foreground="White" Style="{StaticResource ZielonyButton}"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Foreground="White" Header="Wyniki" BorderThickness="0.1" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="5,5,5,31">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Center">
                    <Button x:Name="ObliczPrzeplywButton" Content="Oblicz Przepływ" FontSize="14" Width="200" Height="40" Margin="0,10,25,10" Click="ObliczPrzeplyw_Click" Background="#3c9152" Foreground="White" Style="{StaticResource ZielonyButton}"/>

                    <CheckBox Foreground="White" x:Name="UwzglednijKosztyCheckBox" Content="Uwzględnij koszty" VerticalAlignment="Center">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="Budżet:" Foreground="White" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="15" IsEnabled="{Binding IsChecked, ElementName=UwzglednijKosztyCheckBox}" />

                    <TextBox x:Name="BudzetTextBox" Grid.Row="3" Grid.Column="2" Width="100" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=UwzglednijKosztyCheckBox}" ToolTip="Wpisz maksymalny koszt napraw dróg (liczba całkowita)" />
                </StackPanel>
                <TextBox FontSize="16" TextAlignment="Center" Background="#363636" Foreground="#e4e4e4" x:Name="WynikiTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <StatusBar Background="#262626"
                           Grid.Row="2"
                           Height="25">
                    <StatusBarItem>
                        <TextBlock Foreground="White" x:Name="StatusTekst" Text="Gotowe"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="5,21,5,5" FontStyle="Italic" Foreground="Gray">
            Wprowadź dane w odpowiednich polach (usuń komentarze i dostosuj format). Kliknij przycisk, aby uruchomić obliczenia.
        </TextBlock>

        <GroupBox Header="Wyszukiwanie w pliku (KMP)" Foreground="White" BorderThickness="0.1" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" MaxHeight="250" Margin="5,5,5,5">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="OtworzPlikButton" Content="Otwórz plik" Grid.Row="0" Grid.Column="0" Padding="12,4" Click="OtworzPlik_Click"/>

                <TextBlock Text=" Wzorzec:" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="White" TextAlignment="Right" FontSize="13" Margin="5,0,20,0"/>

                <TextBox x:Name="WzorzecTextBox" Grid.Row="0" Grid.Column="2" Width="200" Margin="2,0,0,0" ToolTip="Wpisz słowo do wyszukania (KMP)"/>

                <Button x:Name="SzukajWPlikuButton" Content="Szukaj wzorca" Grid.Row="0" Grid.Column="3" MinWidth="110" Padding="6,4" Margin="10,0,0,0" Click="SzukajWPliku_Click" Background="#3c9152" Foreground="White" Style="{StaticResource ZielonyButton}"/>

                <TextBlock x:Name="WynikWyszukiwaniaText" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Foreground="#a0ffa0" FontWeight="Bold" Margin="10,0,0,0"/>

                <RichTextBox x:Name="TekstPlikuTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,5" Background="#2b2b2b" Foreground="#f0f0f0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

                <TextBlock x:Name="StatusPlikuText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" FontStyle="Italic" Foreground="Gray" Text="Nie wczytano pliku."/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
